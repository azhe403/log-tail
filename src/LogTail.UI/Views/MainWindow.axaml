<rxui:ReactiveWindow x:TypeArguments="vm:MainWindowViewModel"
                    xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:rxui="using:Avalonia.ReactiveUI"
                    xmlns:vm="using:LogTail.UI.ViewModels"
                    xmlns:models="using:LogTail.Core.Models"
                    xmlns:ws="using:LogTail.Core.Workspace"
                    xmlns:views="using:LogTail.UI.Views"
                    xmlns:converters="using:Avalonia.Data.Converters"
                    x:Class="LogTail.UI.Views.MainWindow"
                    x:DataType="vm:MainWindowViewModel"
                    Title="{Binding WindowTitle}"
                    Icon="/Assets/Icon.png"
                    Width="900"
                    Height="600"
                     DragDrop.AllowDrop="True">
  <rxui:ReactiveWindow.Styles>
    <Style Selector="TabItem">
      <Setter Property="Padding" Value="0" />
      <Setter Property="Margin" Value="0" />
    </Style>
    <!-- Ensure TabControl content host stretches full width (Avalonia Fluent TabControl uses PART_SelectedContentHost) -->
    <Style Selector="TabControl /template/ ContentPresenter#PART_SelectedContentHost">
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>
    <Style Selector="TabControl /template/ ContentPresenter#PART_SelectedContentHost2">
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>
    <!-- Ensure ListBox items stretch full width -->
    <Style Selector="ListBoxItem">
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>
  </rxui:ReactiveWindow.Styles>

  <Grid>
    <DockPanel LastChildFill="True">
    <!-- Sidebar: navigates the log files inside the current folder tab.
         Tabs switch folders, so this is the only place to move between logs.
         Dock left/right follows Settings.SidebarPosition. -->
    <Border DockPanel.Dock="{Binding SidebarDock}"
            Width="300"
            IsVisible="{Binding HasWorkspaces}"
            BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
            BorderThickness="{Binding SidebarBorderThickness}">
      <DockPanel LastChildFill="True">
        <StackPanel DockPanel.Dock="Top" Margin="8,6,8,4" Spacing="4">
          <TextBlock Text="{Binding SelectedWorkspaceLabel}"
                     FontSize="12"
                     FontWeight="SemiBold"
                     TextTrimming="CharacterEllipsis"
                     ToolTip.Tip="{Binding SelectedWorkspaceTab.FilePath}" />
          <Grid ColumnDefinitions="*,Auto,Auto,Auto" VerticalAlignment="Center">
            <TextBlock Grid.Column="0"
                       Text="Log files"
                       FontSize="11"
                       Opacity="0.6"
                       VerticalAlignment="Center" />
            <Button Grid.Column="1"
                    Content="{Binding WorkspaceSortNameLabel}"
                    Command="{Binding SortCommand}"
                    CommandParameter="{x:Static ws:WorkspaceSortCriterion.Name}"
                    FontSize="10"
                    Padding="4,1"
                    Margin="2,0"
                    Background="Transparent"
                    BorderThickness="1"
                    BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                    ToolTip.Tip="Sort by name" />
            <Button Grid.Column="2"
                    Content="{Binding WorkspaceSortSizeLabel}"
                    Command="{Binding SortCommand}"
                    CommandParameter="{x:Static ws:WorkspaceSortCriterion.Size}"
                    FontSize="10"
                    Padding="4,1"
                    Margin="2,0"
                    Background="Transparent"
                    BorderThickness="1"
                    BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                    ToolTip.Tip="Sort by size" />
            <Button Grid.Column="3"
                    Content="{Binding WorkspaceSortDateLabel}"
                    Command="{Binding SortCommand}"
                    CommandParameter="{x:Static ws:WorkspaceSortCriterion.Date}"
                    FontSize="10"
                    Padding="4,1"
                    Margin="2,0"
                    Background="Transparent"
                    BorderThickness="1"
                    BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                    ToolTip.Tip="Sort by date modified" />
          </Grid>
        </StackPanel>
        <ListBox ItemsSource="{Binding WorkspaceFiles}"
                 SelectedItem="{Binding SelectedWorkspaceFile, Mode=TwoWay}"
                 PointerPressed="OnWorkspaceFileClicked"
                 DoubleTapped="OnWorkspaceFileActivated"
                 FontSize="12"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 ScrollViewer.VerticalScrollBarVisibility="Auto">
          <!-- Own item metrics. The Fluent theme paints every ListBoxItem with
               a #363636 background across the full row width, so next to the
               #0F0E0E sidebar a short file name leaves a grey slab. Resting
               rows go transparent; the theme's :pointerover and :selected
               backgrounds still win (higher selector specificity) and the
               bottom border keeps the rows readable. -->
          <ListBox.Styles>
            <Style Selector="ListBoxItem">
              <Setter Property="Background" Value="Transparent" />
              <Setter Property="Padding" Value="6,3" />
              <Setter Property="HorizontalAlignment" Value="Stretch" />
              <Setter Property="HorizontalContentAlignment" Value="Stretch" />
              <Setter Property="BorderThickness" Value="0,0,0,1" />
              <Setter Property="BorderBrush" Value="#20808080" />
            </Style>
            <Style Selector="ListBoxItem /template/ Border">
              <Setter Property="Background" Value="Transparent" />
            </Style>
          </ListBox.Styles>
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="ws:WorkspaceFile">
              <!-- Fixed column widths, no star and no width binding. A star
                   column resolves against the item's content, and a binding to
                   the scroll viewport varies with scrollbar state, so both let
                   the row follow the longest file name. Hard widths cannot:
                   160 + 56 + 62 + 2*5 = 288, which is the 300px sidebar minus
                   the item's 6px padding on each side. -->
              <Grid ColumnDefinitions="160,56,62" ColumnSpacing="5">
                <TextBlock Grid.Column="0"
                           Text="{Binding Name}"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="1"
                           Text="{Binding SizeText}"
                           FontSize="10"
                           Opacity="0.65"
                           VerticalAlignment="Center" />
                <TextBlock Grid.Column="2"
                           Text="{Binding ModifiedText}"
                           FontSize="10"
                           Opacity="0.65"
                           VerticalAlignment="Center" />
                <ToolTip.Tip>
                  <ToolTip>
                    <StackPanel Spacing="2">
                      <TextBlock Text="{Binding Path}" FontSize="11" />
                      <TextBlock Text="{Binding LastModified}" FontSize="10" Opacity="0.7" />
                    </StackPanel>
                  </ToolTip>
                </ToolTip.Tip>
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
        <TextBlock DockPanel.Dock="Bottom"
                   Margin="8,4"
                   FontSize="10"
                   Opacity="0.7"
                   IsVisible="{Binding HasWorkspaceOverflow}"
                   Text="{Binding WorkspaceOverflowCount, StringFormat=+{0} more files not shown}" />
      </DockPanel>
    </Border>

    <DockPanel LastChildFill="True">
      <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,*,Auto">
        <Menu Grid.Column="0">
          <MenuItem Header="_File">
            <MenuItem Header="_Open..." Command="{Binding OpenFileCommand}" />
            <Separator />
            <MenuItem Header="E_xit" />
          </MenuItem>
        </Menu>
        <TextBox x:Name="SearchTextBox"
                 Grid.Column="1"
                 Width="240"
                 HorizontalAlignment="Right"
                 Text="{Binding Search.SearchText}"
                 PlaceholderText="Find in logs… (Ctrl+F)"
                 Margin="8,2,8,2"
                 VerticalAlignment="Center" />
        <Button Grid.Column="2"
                Command="{Binding OpenSettingsCommand}"
                Background="Transparent"
                BorderThickness="0"
                Padding="8,4"
                ToolTip.Tip="Settings"
                VerticalAlignment="Center">
          <Path Width="16"
                Height="16"
                Stretch="Uniform"
                Fill="{DynamicResource SystemControlForegroundBaseHighBrush}"
                Data="M19.14,12.94c0.04-0.3,0.06-0.61,0.06-0.94c0-0.32-0.02-0.64-0.07-0.94l2.03-1.58c0.18-0.14,0.23-0.41,0.12-0.61l-1.92-3.32c-0.12-0.22-0.37-0.29-0.59-0.22l-2.39,0.96c-0.5-0.38-1.03-0.7-1.62-0.94L14.4,2.81c-0.04-0.24-0.24-0.41-0.48-0.41h-3.84c-0.24,0-0.43,0.17-0.47,0.41L9.25,5.35C8.66,5.59,8.12,5.92,7.63,6.29L5.24,5.33c-0.22-0.08-0.47,0-0.59,0.22L2.74,8.87C2.62,9.08,2.66,9.34,2.86,9.48l2.03,1.58C4.84,11.36,4.8,11.69,4.8,12s0.02,0.64,0.07,0.94l-2.03,1.58c-0.18,0.14-0.23,0.41-0.12,0.61l1.92,3.32c0.12,0.22,0.37,0.29,0.59,0.22l2.39-0.96c0.5,0.38,1.03,0.7,1.62,0.94l0.36,2.54c0.05,0.24,0.24,0.41,0.48,0.41h3.84c0.24,0,0.44-0.17,0.47-0.41l0.36-2.54c0.59-0.24,1.13-0.56,1.62-0.94l2.39,0.96c0.22,0.08,0.47,0,0.59-0.22l1.92-3.32c0.12-0.22,0.07-0.47-0.12-0.61L19.14,12.94z M12,15.6c-1.98,0-3.6-1.62-3.6-3.6s1.62-3.6,3.6-3.6s3.6,1.62,3.6,3.6S13.98,15.6,12,15.6z" />
        </Button>
      </Grid>

      <Grid DockPanel.Dock="Bottom" Height="40" ColumnDefinitions="*,Auto,Auto" Margin="8,0">
        <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
          <TextBlock Text="{Binding SelectedTabStatus}"
                     FontSize="11"
                     TextTrimming="CharacterEllipsis" />
          <TextBlock Text="{Binding StatusMessage}"
                     FontSize="10"
                     Opacity="0.7"
                     IsVisible="{Binding StatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                     TextTrimming="CharacterEllipsis" />
        </StackPanel>
        <!-- Resource readouts, app-level above per-tab. CPU and memory are
             process-wide facts — one process, every tab shares it — so they cannot
             be split per tab; the read rate and buffer memory below them are the
             tab on screen's own share. -->
        <StackPanel Grid.Column="1"
                    VerticalAlignment="Center"
                    Spacing="2"
                    Margin="8,0">
          <TextBlock Text="{Binding AppResourceText}"
                     FontSize="10"
                     Opacity="0.7"
                     HorizontalAlignment="Right" />
          <TextBlock Text="{Binding TabResourceText}"
                     FontSize="10"
                     Opacity="0.7"
                     HorizontalAlignment="Right" />
        </StackPanel>
        <ToggleSwitch Grid.Column="2"
                      IsChecked="{Binding AutoScroll, Mode=TwoWay}"
                      OnContent="Auto-scroll"
                      OffContent="Auto-scroll"
                      FontSize="11"
                      VerticalAlignment="Center" />
      </Grid>

      <!-- Log area + search results split panel. The splitter above the
           panel is what the user drags to resize it; the row height lives in
           SearchViewModel.PanelHeight so the size survives closing/reopening
           the panel during the session. -->
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="{Binding Search.PanelHeight, Mode=TwoWay}" />
        </Grid.RowDefinitions>

        <TabControl Grid.Row="0"
                    x:Name="MainTabControl"
                  ItemsSource="{Binding Tabs}"
                  SelectedItem="{Binding SelectedTab, Mode=OneWay}"
                  HorizontalAlignment="Stretch"
                  VerticalAlignment="Stretch"
                  HorizontalContentAlignment="Stretch"
                  VerticalContentAlignment="Stretch">
        
        <TabControl.ItemTemplate>
          <DataTemplate>
            <views:TabItemView />
          </DataTemplate>
        </TabControl.ItemTemplate>
        
        <TabControl.ContentTemplate>
          <DataTemplate x:DataType="vm:TabViewModel">
            <!-- Folder tab: a single click previews a log inside it, a double
                 click opens it as its own tab. Until something is previewed the
                 tab shows the workspace summary. Log tab: log lines. -->
            <Panel HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
              <StackPanel IsVisible="{Binding !ShowsLog}"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"
                          Spacing="6"
                          MaxWidth="520">
                <TextBlock Text="{Binding FileName}"
                           FontSize="16"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding FilePath}"
                           FontSize="11"
                           Opacity="0.6"
                           TextAlignment="Center"
                           TextWrapping="Wrap" />
                <TextBlock Text="Click a file in the sidebar to view its logs in this tab"
                           FontSize="12"
                           Opacity="0.7"
                           TextAlignment="Center"
                           Margin="0,6,0,0" />
                <TextBlock Text="Double-click to open it as its own tab"
                           FontSize="11"
                           Opacity="0.55"
                           TextAlignment="Center" />
              </StackPanel>

              <Grid HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    IsVisible="{Binding ShowsLog}">
              <ScrollViewer HorizontalScrollBarVisibility="Auto"
                            VerticalScrollBarVisibility="Auto"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch"
                            Name="TabLogScrollViewer">
                <!-- MinWidth floors the log area at the window width. A
                     ScrollViewer with an Auto horizontal scrollbar measures its
                     content with unbounded width, so without this the log
                     shrinks to the longest line. A line longer than the window
                     still overflows and scrolls: MinWidth is only a floor. -->
                <ItemsControl ItemsSource="{Binding LogSource.LogEvents}"
                              HorizontalAlignment="Stretch"
                              MinWidth="{Binding $parent[ScrollViewer].Bounds.Width}"
                              Name="TabLogItemsControl">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <VirtualizingStackPanel />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="models:EnrichedLogEvent">
                      <Grid ColumnDefinitions="Auto,*"
                            HorizontalAlignment="Stretch"
                            Margin="0"
                            MinHeight="20"
                            VerticalAlignment="Center">
                        <Grid.ContextMenu>
                          <ContextMenu>
                            <MenuItem Header="Copy" Click="OnCopySelectedClick" />
                            <MenuItem Header="Copy entire line" Click="OnCopyLineClick" />
                          </ContextMenu>
                        </Grid.ContextMenu>
                        <Border Grid.Column="0"
                                Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
                                BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                                BorderThickness="0,0,1,0"
                                ZIndex="1">
                          <Border.RenderTransform>
                            <TranslateTransform X="{Binding $parent[ScrollViewer].Offset.X}" />
                          </Border.RenderTransform>
                          <TextBlock Text="{Binding LineNumber, StringFormat={}{0}.}"
                                     Width="55"
                                     TextAlignment="Right"
                                     Margin="6,1,10,1"
                                     Opacity="0.5"
                                     FontFamily="Cascadia Code,Consolas,Menlo,DejaVu Sans Mono,monospace"
                                     FontSize="12" />
                        </Border>
                        <SelectableTextBlock Grid.Column="1"
                                             Text="{Binding Raw.Line}"
                                             Margin="0,1,10,1"
                                             TextWrapping="NoWrap"
                                             FontFamily="Cascadia Code,Consolas,Menlo,DejaVu Sans Mono,monospace"
                                             FontSize="12"
                                             Focusable="True" />
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
              </Grid>
            </Panel>
          </DataTemplate>
        </TabControl.ContentTemplate>
        
      </TabControl>

        <GridSplitter Grid.Row="1"
                      Height="4"
                      ResizeDirection="Rows"
                      IsVisible="{Binding Search.ShowPanel}"
                      Background="{DynamicResource SystemControlForegroundBaseLowBrush}"
                      DragCompleted="OnSearchPanelSplitterDragCompleted" />

        <Border Grid.Row="2"
                x:Name="SearchResultsPanel"
                IsVisible="{Binding Search.ShowPanel}"
                BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                BorderThickness="0,1,0,0">
          <Grid RowDefinitions="Auto,*">
            <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" Margin="8,4">
              <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <TextBlock Text="{Binding Search.MatchCountText}"
                           FontSize="11"
                           VerticalAlignment="Center" />
                <ToggleSwitch IsChecked="{Binding Search.SearchAllTabs, Mode=TwoWay}"
                              FontSize="10"
                              VerticalAlignment="Center" />
                <TextBlock Text="All tabs"
                           FontSize="11"
                           Opacity="0.7"
                           VerticalAlignment="Center" />
              </StackPanel>
              <Button Grid.Column="2"
                      Content="×"
                      Command="{Binding Search.CloseCommand}"
                      Background="Transparent"
                      BorderThickness="0"
                      Padding="8,2"
                      ToolTip.Tip="Close (Esc)"
                      VerticalAlignment="Center" />
            </Grid>
            <ListBox Grid.Row="1"
                     ItemsSource="{Binding Search.Matches}"
                     SelectedItem="{Binding Search.SelectedMatch, Mode=TwoWay}"
                     DoubleTapped="OnSearchResultActivated"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
              <!-- Same tight 20px rows as the tail. The Fluent ListBoxItem
                   default padding and min-height would make result rows
                   noticeably taller than the log rows they point at. -->
              <ListBox.Styles>
                <Style Selector="ListBoxItem">
                  <Setter Property="Padding" Value="0" />
                  <Setter Property="MinHeight" Value="20" />
                </Style>
              </ListBox.Styles>
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:LogSearchMatch">
                  <Grid ColumnDefinitions="Auto,55,*"
                        MinHeight="20"
                        VerticalAlignment="Center">
                    <TextBlock Grid.Column="0"
                               Text="{Binding FileName}"
                               MaxWidth="150"
                               TextTrimming="CharacterEllipsis"
                               FontSize="11"
                               Opacity="0.7"
                               VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1"
                               Text="{Binding LineNumber}"
                               TextAlignment="Right"
                               FontSize="11"
                               Opacity="0.5"
                               VerticalAlignment="Center"
                               Margin="0,0,8,0" />
                    <TextBlock Grid.Column="2"
                               Text="{Binding Line}"
                               TextTrimming="CharacterEllipsis"
                               FontFamily="Cascadia Code,Consolas,Menlo,DejaVu Sans Mono,monospace"
                               FontSize="12"
                               VerticalAlignment="Center"
                               ToolTip.Tip="{Binding Line}" />
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </Grid>
        </Border>
      </Grid>

      <!-- Empty State (when no tabs) -->
      <Panel IsVisible="{Binding !Tabs.Count}"
             HorizontalAlignment="Center"
             VerticalAlignment="Center">
        <StackPanel Spacing="8">
          <TextBlock Text="Drop a log file here" 
                     HorizontalAlignment="Center"
                     FontSize="16" />
          <TextBlock Text="or use File > Open"
                     HorizontalAlignment="Center"
                     Opacity="0.6" />
        </StackPanel>
      </Panel>

    </DockPanel>
    </DockPanel>

    <!-- Global Loading Indicator Overlay (Centered in Window) -->
    <Border Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
            Opacity="0.85"
            IsVisible="{Binding ActiveLogTab.IsLoading, FallbackValue=False}"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch">
      <StackPanel HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  Spacing="16"
                  MaxWidth="500">
        <ProgressBar IsIndeterminate="True"
                     Width="240"
                     Height="4"
                     HorizontalAlignment="Center" />
        <StackPanel HorizontalAlignment="Center" Spacing="6">
          <TextBlock Text="Loading log file..."
                     FontSize="14"
                     FontWeight="SemiBold"
                     TextAlignment="Center"
                     HorizontalAlignment="Center" />
          <TextBlock Text="{Binding ActiveLogTab.FilePath}"
                     FontSize="11"
                     Opacity="0.6"
                     MaxWidth="450"
                     TextAlignment="Center"
                     TextTrimming="CharacterEllipsis"
                     HorizontalAlignment="Center" />
        </StackPanel>
      </StackPanel>
    </Border>
  </Grid>
</rxui:ReactiveWindow>