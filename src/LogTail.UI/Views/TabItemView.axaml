<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:LogTail.UI.ViewModels"
             xmlns:converters="using:Avalonia.Data.Converters"
             x:Class="LogTail.UI.Views.TabItemView"
             x:DataType="vm:TabViewModel">
     
    <Border BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
            BorderThickness="0,0,1,0"
            Padding="8,1,8,1">
        <StackPanel Orientation="Horizontal" Spacing="8">
            <StackPanel Orientation="Vertical" Spacing="0" VerticalAlignment="Center" Margin="0,0">
                <TextBlock Text="{Binding ParentFolder}"
                           FontSize="10"
                           Opacity="0.7"
                           TextTrimming="CharacterEllipsis"
                           IsVisible="{Binding ParentFolder, Converter={x:Static converters:StringConverters.IsNotNullOrEmpty}}"
                           VerticalAlignment="Center" />
                <TextBlock Text="{Binding FolderName}"
                           FontSize="12"
                           TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center" />
            </StackPanel>
            <Button Classes="tab-close"
                Content="X"
                FontSize="10"
                Padding="2,0"
                Command="{Binding $parent[TabControl].((vm:MainWindowViewModel)DataContext).CloseTabCommand}"
                CommandParameter="{Binding}" />
        <!-- Per-tab resource facts. Bound through LogSource so a folder tab reports
             the file it is previewing rather than the folder's own empty buffer.
             The tab strip itself stays uncluttered — these are one hover away. -->
        <ToolTip.Tip>
            <ToolTip>
                <StackPanel Spacing="2" MaxWidth="520">
                    <TextBlock Text="{Binding LogSource.FilePath}" FontSize="11" />
                    <TextBlock Text="{Binding LogSource.BufferFactsText}"
                               FontSize="11"
                               Opacity="0.7" />
                    <TextBlock Text="{Binding LogSource.ReadRateText}"
                               FontSize="11"
                               Opacity="0.7" />
                </StackPanel>
            </ToolTip>
        </ToolTip.Tip>
    </StackPanel>
    </Border>
     
</UserControl>
